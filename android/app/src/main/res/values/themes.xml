<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GhostDay" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg2</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textColorHint">@color/fg_mute</item>
        <item name="colorAccent">@color/acc</item>
        <item name="android:colorControlActivated">@color/acc</item>
    </style>

    <style name="GhostIconButton">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">9dp</item>
    </style>

    <style name="GhostWideButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/fg_dim</item>
    </style>
</resources>
